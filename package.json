{
  "name": "finance",
  "version": "2.8.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "doctor": "expo install --check",
    "test:logic": "node --test tests/logic.test.cjs",
    "test:source": "node tests/source.test.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:db": "python -m unittest discover -s tests -p \"test_*.py\" -q",
    "quality": "node scripts/check-repository.cjs",
    "version:set": "node scripts/set-version.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.30",
    "expo-constants": "^57.0.0",
    "expo-crypto": "^57.0.0",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.13",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.28",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "^57.0.0",
    "expo-sqlite": "^57.0.0",
    "expo-status-bar": "^57.0.0",
    "expo-system-ui": "^57.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
